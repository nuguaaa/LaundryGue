<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. KEAMANAN TINGKAT TINGGI: Blokir akses langsung ke file sensitif (.env, .git, composer, artisan)
    RewriteRule ^(\.env|\.git|\.editorconfig|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # 2. REWRITE KE FOLDER PUBLIC: Arahkan seluruh permintaan pengunjung ke folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
